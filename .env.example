# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit the real .env — it holds secrets.

# --- Database ---
DB_NAME=skeleton
DB_USER=skeleton
# Use a long, random password in any real deployment.
DB_PASSWORD=change-me

# --- Django ---
# Required: 50+ random characters — the backend refuses to start without it.
# Generate one with:
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Set to True only once the site is served over HTTPS (TLS on nginx or on a
# load balancer in front): redirects HTTP->HTTPS, sends HSTS, Secure cookies.
DJANGO_HTTPS_ONLY=False
# Full origins allowed to submit forms (Django admin) behind the proxy, e.g.
# https://your-domain.com — comma-separated. Usually only needed with HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Comma-separated hostnames/IPs this backend will be reached as. Must
# include every address used to reach it — the server's domain if it has
# one, AND its LAN IP if other machines on the network will access it that
# way (e.g. 192.168.1.50). Find the server's LAN IP with `hostname -I`
# (Linux) or `ipconfig` (Windows). Left empty, Django rejects every request.
DJANGO_ALLOWED_HOSTS=your-domain.com,your-server-ip
# Only needed if the frontend is hosted on a different origin than this
# backend (the default setup here proxies /api/ through the same origin
# via nginx, so this can usually stay empty).
DJANGO_CORS_ALLOWED_ORIGINS=

# --- SeaweedFS (generic object storage through its S3 gateway — see the
#     storage helpers in backend/core/helpers.py; remove this section plus
#     the seaweedfs service in compose.yml if unused) ---
SEAWEEDFS_ACCESS_KEY=skeleton_seaweedfs
# Use a long, random secret in any real deployment.
SEAWEEDFS_SECRET_KEY=change-me
# Bucket is created automatically by the backend on first upload.
SEAWEEDFS_BUCKET=skeleton

# --- Frontend ---
# Host port nginx (the frontend) listens on. Binding with no host IP (the
# default here) publishes on every network interface, so anyone on the same
# network as the server can reach it at http://<server-ip>:${FRONTEND_PORT}/
# — not just localhost. Make sure DJANGO_ALLOWED_HOSTS above matches
# whatever address you actually use.
FRONTEND_PORT=80
